{
  // dsh-code-review 0.2.0 —— 构建配置（内核侧）
  // 继承类型检查配置，但打开 emit：把 src 下的 TypeScript 编译成 ESM JavaScript。
  // 客户端面板（浏览器 bundle）另行用打包器处理，不在此配置范围内。
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    // 不产出 sourcemap：发布包体积减半，也不把源码结构暴露给使用者。
    // 需要调试时用 dist 里的 .d.ts + 源码 worktree 对照。
    "declarationMap": false,
    "sourceMap": false,
    "outDir": "dist",
    "rootDir": "src"
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist", "engine", "test", "src/**/*.js"]
}
