{
  // dsh-code-review 0.2.0 —— TypeScript 类型检查配置
  // 说明：0.1.3 的 src/*.js 保持不动（作为回退基线），本配置只覆盖新增的 TypeScript 源码。
  // 构建产物与类型检查分离：此处 noEmit，仅做静态检查；打包交给构建脚本。
  "compilerOptions": {
    // 目标运行时：DSH 自带 Node 24.21.0
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",

    // 严格性：全部打开，避免重写过程中引入隐式 any / 越界访问
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "exactOptionalPropertyTypes": true,
    "useUnknownInCatchVariables": true,

    // 模块与互操作
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,

    // 输出：仅类型检查，不生成文件
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  // 只检查新写的 TypeScript 源码
  "include": ["src/**/*.ts", "test/**/*.ts"],
  "exclude": ["node_modules", "dist", "engine", "src/**/*.js"]
}
