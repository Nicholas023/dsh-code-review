{
  "name": "dsh-code-review",
  "version": "0.2.0",
  "description": "智能代码审查插件（0.2.0）：把自研 Node/TypeScript 审查内核接入 DSH —— 对仓库 diff / 全仓扫描执行安全脱敏、找 bug、冗余与无关代码三个固定视角的评审，产出 Markdown + JSON 双报告。内核独立进程运行、PTC 模式（模型写程序调用只读工具）、主/子 agent 分层，token 开销可解释。",
  "type": "module",
  "main": "dist/plugin/index.js",
  "exports": {
    ".": "./dist/plugin/index.js",
    "./client": "./dist/client/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "cordis.patch.yml",
    "README.md",
    "UPGRADING.md",
    "CHANGELOG.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json && npm run typecheck:client",
    "build": "npm run build:kernel && npm run build:client",
    "test": "vitest run",
    "test:watch": "vitest",
    "bench": "node scripts/benchmark-tokens.mjs",
    "check": "npm run typecheck && npm run test",
    "verify": "npm run typecheck && npm run build && npm run test",
    "release:check": "npm run build && node scripts/release.mjs",
    "build:kernel": "tsc -p tsconfig.build.json",
    "build:client": "node scripts/build-client.mjs",
    "typecheck:client": "tsc -p tsconfig.client.json"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "code-review",
    "codecheck",
    "deepseek-harness",
    "security",
    "review"
  ],
  "license": "Apache-2.0",
  "author": "dsh-code-review contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Nicholas023/dsh-code-review.git"
  },
  "bugs": {
    "url": "https://github.com/Nicholas023/dsh-code-review/issues"
  },
  "homepage": "https://github.com/Nicholas023/dsh-code-review#readme",
  "engines": {
    "node": ">=22",
    "dsh": ">=0.2.0-rc.2 <0.3.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/react": "^18.3.31",
    "react": "^18.3.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "dependencies": {
    "ajv": "^8.20.0"
  }
}
